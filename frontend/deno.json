{
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "check": "deno check src/**/*.tsx src/**/*.ts",
    "test": "deno test src/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "react": "npm:react@^18.3",
    "react/": "npm:react@^18.3/",
    "react-dom": "npm:react-dom@^18.3",
    "react-dom/": "npm:react-dom@^18.3/",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1",
    "vite": "npm:vite@^5"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"],
    "strict": true
  },
  "nodeModulesDir": "auto"
}
